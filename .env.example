# Public URL of the site. The MCP connector URL is ${NEXT_PUBLIC_SITE_URL}/mcp and Solana token
# metadata URIs point at ${NEXT_PUBLIC_SITE_URL}/api/metadata/<id>, so set this before any launch.
NEXT_PUBLIC_SITE_URL=https://your-domain.example

# ---------------------------------------------------------------- Robinhood Chain
# mainnet (4663) or testnet (46630)
NEXT_PUBLIC_ROBINHOOD_NETWORK=mainnet
# Optional RPC override used by the browser and, unless ROBINHOOD_RPC_URL is set, the server.
NEXT_PUBLIC_ROBINHOOD_RPC_URL=
ROBINHOOD_RPC_URL=
# PadFactory address from `forge script script/Deploy.s.sol`. Robinhood launches stay closed while empty.
NEXT_PUBLIC_PAD_FACTORY=

# ---------------------------------------------------------------- Solana
# mainnet-beta or devnet
NEXT_PUBLIC_SOLANA_CLUSTER=mainnet-beta
# Browser RPC. Use a dedicated provider in production; the public endpoint is heavily rate limited.
NEXT_PUBLIC_SOLANA_RPC_URL=
# Server RPC (falls back to the browser one). getProgramAccounts must be allowed for registry sync.
SOLANA_RPC_URL=
# Partner config from `node scripts/solana-create-config.ts --send`. Solana launches stay closed while empty.
NEXT_PUBLIC_DBC_CONFIG=

# ---------------------------------------------------------------- storage
# Postgres connection string. Without it the app uses an embedded PGlite database in PGLITE_DIR.
DATABASE_URL=
PGLITE_DIR=./.data/pglite

# ---------------------------------------------------------------- launch provenance
# Keys the platform signs every launch it prepares with, so "born from a prompt" is provable
# on-chain. The EVM address goes into the factory (PAD_ATTESTER at deploy, or setAttester later);
# the Solana key co-signs a memo in each pool-creation transaction. Unset: launches are recorded
# as direct. Published at /.well-known/launch-provenance.json.
ATTESTER_PRIVATE_KEY=
# Solana secret key as a JSON byte array or base58.
ATTESTER_SOLANA_SECRET=
