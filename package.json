{
  "name": "promptpad",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "abi": "node scripts/gen-abi.mjs",
    "typecheck": "next typegen && tsc --noEmit",
    "cf:build": "opennextjs-cloudflare build",
    "cf:preview": "opennextjs-cloudflare build && wrangler dev",
    "cf:deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@meteora-ag/dynamic-bonding-curve-sdk": "^1.5.13",
    "@modelcontextprotocol/sdk": "^1.31.0",
    "@solana/spl-token": "^0.4.15",
    "@solana/wallet-adapter-base": "^0.9.28",
    "@solana/wallet-adapter-react": "^0.15.40",
    "@solana/wallet-adapter-react-ui": "^0.9.40",
    "@solana/web3.js": "^1.99.0",
    "@tanstack/react-query": "^5.104.0",
    "bn.js": "^5.2.5",
    "bs58": "^6.0.0",
    "next": "16.3.7",
    "pg": "^8.23.0",
    "pg-cloudflare": "^1.4.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "viem": "^2.57.1",
    "wagmi": "^3.7.7",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "^1.20.7",
    "@types/bn.js": "^5.2.0",
    "@types/node": "^24.19.0",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "esbuild": "^0.28.2",
    "eslint": "^9",
    "eslint-config-next": "16.3.7",
    "typescript": "^5",
    "vitest": "^5.0.2",
    "wrangler": "^4.144.0"
  },
  "allowScripts": {
    "esbuild@0.25.4": true,
    "esbuild@0.28.2": true,
    "esbuild@0.28.1": true,
    "workerd@1.20260926.1": true,
    "bigint-buffer": false,
    "bufferutil": false,
    "utf-8-validate": false,
    "unrs-resolver": false
  }
}
